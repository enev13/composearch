# Django debug mode
DEBUG=True
# Django secret key string
SECRET_KEY=not_so_secret_key_qwerty1234
# Django production mode
PRODUCTION=False
# Django allowed hosts
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost
# Cache timeout in seconds
CACHE_TIMEOUT=3600
# Browser timeout in milliseconds
BROWSER_TIMEOUT=20000
# Max concurrent distributor page fetches per process
SEARCH_CONCURRENCY_LIMIT=6
# Seconds of inactivity before the shared browser shuts down (0 = never)
BROWSER_IDLE_TIMEOUT=300
# Consecutive failures before a distributor is auto-disabled
DISTRIBUTOR_FAILURE_THRESHOLD=5
# Default search term used by distributor health probes (empty = probe only distributors with probe_query)
PROBE_DEFAULT_QUERY=
# Number of top search queries kept in the leaderboard
TOP_SEARCHES_LIMIT=100
# Admin superuser, created on container startup only when missing (skipped when username is empty)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=s3cr3t-passw0rd
# Wipe + reseed the DB on every container start (false keeps data across restarts)
RESET_DB_ON_START=false

# PostgreSQL parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespass
POSTGRES_HOST=postgres
POSTGRES_DB=composearch
POSTGRES_NAME=composearch
POSTGRES_PORT=5432

# Redis parameters
REDIS_URL=redis://redis:6379/0
