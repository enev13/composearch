# Django debug mode
DEBUG=True
# Django secret key string
SECRET_KEY=not_so_secret_key_qwerty1234
# Django production mode
PRODUCTION=False
# Django allowed hosts
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost
# Cache timeout in seconds
CACHE_TIMEOUT=3600
# Browser timeout in milliseconds
BROWSER_TIMEOUT=10_000
# Max concurrent distributor page fetches per process
SEARCH_CONCURRENCY_LIMIT=6
# Seconds of inactivity before the shared browser shuts down (0 = never)
BROWSER_IDLE_TIMEOUT=300

# PostgreSQL parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespass
POSTGRES_HOST=postgres
POSTGRES_DB=composearch
POSTGRES_NAME=composearch
POSTGRES_PORT=5432

# Redis parameters
REDIS_URL=redis://redis:6379/0
